# همان دیتابیس اپ — پنل فقط می‌خواند و می‌نویسد، مالک اسکیما نیست.
DATABASE_URL=postgres://gheseyar:رمز@db:5432/gheseyar

# رمز امضای نشست پنل. حتماً متفاوت از SESSION_SECRET اپ والدین.
ADMIN_SESSION_SECRET=

# پیامک کد دومرحله‌ای — قالب مجزای ADMIN_LOGIN_OTP
SMSIR_API_KEY=
SMSIR_ADMIN_TEMPLATE_ID=
SMSIR_TEMPLATE_ID=
# شماره‌ای که هنگام قفل شدن حساب ادمین پیامک می‌گیرد
SUPERADMIN_MOBILE=09195345339

# کپچای ایرانی — بعد از دو تلاش ناموفق ورود
ARCAPTCHA_SITE_KEY=
ARCAPTCHA_SECRET_KEY=

# برای تطبیق پرداخت‌ها از داخل پنل
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=0
# رمز مشترک برای صدا زدن مسیرهای job از cron
CRON_SECRET=
